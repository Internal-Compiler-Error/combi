{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "combi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built web app. /api/* goes to the worker; any other unknown path gets index.html so
  // client-side routes like /m/10416 work on reload.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Points at the `combi` Neon project's main branch (direct, unpooled endpoint)
      "id": "36c14748c0aa49f3a88aaec5498dcdcc",
      // Used by `npm run dev`; override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      // Hyperdrive requires a password here; the dev database trusts local connections, so any works.
      "localConnectionString": "postgres://combi:combi@localhost:5432/combi"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
